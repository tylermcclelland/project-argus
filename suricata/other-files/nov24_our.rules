# rules crafted based on what is defined here: https://docs.suricata.io/en/suricata-7.0.11/rules/index.html
# for suricata version 7.0.10

# Morgan's
alert tcp any any -> $HOME_NET any (msg: "WARNING: Possible DoS attack - SYN Flood detected!"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 5, seconds 5; classtype:attempted-dos; priority:1; sid:123; rev:2;)
# DNS Cache Poisoning rule
# show all queries as a test
# alert dns any any -> any any (msg:"DNS QUERY test"; dns.query; content:"mr-miyagi.com"; sid:120; rev:1;)
# content:"." filters for most domain names
alert dns any any -> any any (msg:"WARNING: Possible DNS Query Flood (5+ cases detected)"; dns.query; content:"."; threshold:type threshold, track by_src, count 5, seconds 1; classtype:attempted-recon; sid:120; rev:3;)

# Tyler's
#alert tcp any any -> $HOME_NET any (msg:"Potential Port Scan Detected"; priority:1; target:[src_ip|dest_ip] flow:to_server; flags:S,12; threshold:type both, track by_src, count 5, seconds 5; sid:44; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"Potential Port Scan Detected"; priority:1; flow:to_server; flags:S,12; threshold:type both, track by_src, count 5, seconds 5; sid:44; rev:1;)
#alert tcp any any -> any any (msg:"Potential Port Scan Detected"; priority:1; flow:to_server; flags:S,12; classtype:attempted-recon; threshold:type threshold, track by_src, count 1, seconds 20; sid:44; rev:1;)
#alert tcp any any -> 192.168.0.83 any (msg:"Can i see something..."; priority:1; sid:1; rev:1;)
